{
  "name": "cento-mobile",
  "version": "1.0.0",
  "description": "Cento & Co. — Banca Patrimonial y Rendimiento Líquido en React Native con Expo",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:preview": "eas build -p ios --profile preview",
    "build:ios": "eas build -p ios --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/hanken-grotesk": "^0.2.3",
    "@expo-google-fonts/newsreader": "^0.2.3",
    "expo": "~51.0.28",
    "expo-font": "~12.0.9",
    "expo-haptics": "~13.0.1",
    "expo-local-authentication": "~14.0.1",
    "expo-secure-store": "~13.0.1",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-svg": "15.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "typescript": "~5.3.3"
  },
  "private": true
}
